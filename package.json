{
  "name": "miniledger",
  "version": "0.1.0",
  "description": "MiniLedger - Personal lending ledger mobile app and Fastify backend",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:status": "docker compose ps",
    "dev:backend": "npm --prefix backend run dev",
    "dev:mobile": "npm --prefix mobile start",
    "dev": "concurrently -n \"BACKEND,MOBILE\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:mobile\"",
    "test:backend": "npm --prefix backend test",
    "test": "npm run test:backend",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:mobile": "npm --prefix mobile run typecheck",
    "typecheck": "npm run typecheck:backend && npm run typecheck:mobile"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
