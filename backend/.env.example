# MiniLedger Backend Environment Configuration (Template)
# Copy this file to .env and adjust variables as needed for local development.

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection URLs (Development & Isolated Test Database)
DATABASE_URL="postgresql://miniledger_dev:miniledger_dev_secret@localhost:5432/miniledger_db?schema=public"
TEST_DATABASE_URL="postgresql://miniledger_dev:miniledger_dev_secret@localhost:5432/miniledger_test?schema=public"

# Authentication & Security
# Dedicated JWT signing key (minimum 32 characters)
JWT_SECRET="miniledger_local_development_jwt_secret_key_32chars_min"
# Server-side HMAC secret for hashing mock OTP challenges before DB storage
OTP_HASH_SECRET="miniledger_local_development_otp_hash_secret_32chars_min"
# OTP validity duration in seconds (default: 300 = 5 minutes)
OTP_EXPIRES_IN_SECONDS=300
# Maximum failed verification attempts before challenge invalidation
MAX_OTP_ATTEMPTS=5
# Minimum seconds between OTP requests for the same phone number
OTP_COOLDOWN_SECONDS=60
# Maximum OTP requests per phone within the issuance window
OTP_MAX_ISSUANCE_PER_WINDOW=5
# Rolling window size in seconds for phone-level OTP issuance limiting
OTP_ISSUANCE_WINDOW_SECONDS=600

# JSON Web Token (JWT) Configuration
# Token expiration (e.g. "1h", "30m", "7d")
JWT_EXPIRES_IN="1h"

# Application Time Zone (used for calculating calendar-day boundaries and overdue status)
APP_TIME_ZONE="Asia/Kolkata"

# Cross-Origin Resource Sharing (CORS) - * allows mobile & web previews in local dev
CORS_ORIGIN="*"
