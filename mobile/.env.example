# MiniLedger Mobile Environment Variables (Template)
# Copy this file to mobile/.env for local overrides.

# Backend API base URL
# Default for web preview and local simulators:
EXPO_PUBLIC_API_URL="http://localhost:4000"

# For physical mobile device testing via Expo Go on the same Wi-Fi network:
# Replace localhost with your computer's local network IP address, e.g.:
# EXPO_PUBLIC_API_URL="http://192.168.1.50:4000"
